<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the default light Wisteria palette on a fresh install. -->
    <color name="launch_background">#EEE8F7</color>
    <style name="Base.Theme.AsmrPlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.AsmrPlayer" parent="@style/Base.Theme.AsmrPlayer" />
</resources>
