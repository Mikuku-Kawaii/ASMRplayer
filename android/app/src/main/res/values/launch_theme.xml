<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Matches the default light Wisteria palette on a fresh install. -->
    <color name="launch_background">#EEE8F7</color>
    <style name="Theme.AsmrPlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="26">true</item>
    </style>
</resources>
