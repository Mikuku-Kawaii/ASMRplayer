{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASMR Player",
  "version": "1.1.1",
  "identifier": "com.asmrplayer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:14520",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ASMR Player",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0f1117"
      },
      {
        "label": "island",
        "create": false,
        "title": "ASMR Player Island",
        "url": "index.html?window=island",
        "width": 160,
        "height": 42,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/mpv-2.dll": "mpv-2.dll",
      "binaries/vulkan-1.dll": "vulkan-1.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNUNCQkEzMTU0MEIwQkEKUldTNnNFQVZvN3RjTENVdmkrWk9BZStQM1N4TFJISk8vU2M0QVZNZVRCMk5Ub2RCSjBTKzZhd2UK",
      "endpoints": [
        "https://github.com/Mikuku-Kawaii/ASMRplayer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
